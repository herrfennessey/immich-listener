# Environment variables for docker-compose.
# Copy this file to .env and fill in the values.

# Required: Immich owner API key.
IMMICH_API_KEY=

# The Docker network Immich's Compose project created, so the sidecar can reach
# `immich-server` by name. Find it with `docker network ls` (typically
# "immich_default"). See the README "Connecting to Immich" section.
# IMMICH_NETWORK=immich_default

# Immich server base URL (default: http://immich-server:2283).
# IMMICH_BASE_URL=http://immich-server:2283

# NATS JetStream stream name (default: IMMICH).
# NATS_STREAM_NAME=IMMICH

# NATS subject prefix (default: immich).
# NATS_SUBJECT_PREFIX=immich

# JetStream KV bucket for the asset→albums membership index (default: immich_asset_albums).
# MEMBERSHIP_BUCKET=immich_asset_albums

# How long the sidecar waits between sync stream passes (default: 30s).
# SYNC_INTERVAL=30s

# Enable real-time Socket.IO doorbell (default: true).
# SOCKETIO_ENABLED=true
