# Environment variables for docker-compose.
# Copy this file to .env and fill in the values.

# Required: credentials for the Immich user whose durable sync checkpoint the
# sidecar maintains and whose Socket.IO events it receives.
IMMICH_EMAIL=
IMMICH_PASSWORD=

# Persistent location for the account-bound session token. The default is
# /data/session-token, which Docker Compose mounts as a writable named volume.
# IMMICH_SESSION_TOKEN_FILE=/data/session-token

# The Docker network of Immich's Compose project. The sidecar joins it to reach
# immich-server by name. Find it with `docker network ls` (often
# "immich_default"). See the README "Connecting to Immich" section.
# IMMICH_NETWORK=immich_default

# Immich server base URL (default: http://immich-server:2283).
# IMMICH_BASE_URL=http://immich-server:2283

# NATS JetStream stream name (default: IMMICH).
# NATS_STREAM_NAME=IMMICH

# NATS subject prefix (default: immich).
# NATS_SUBJECT_PREFIX=immich

# Idle wait between sync passes (default: 30s).
# SYNC_INTERVAL=30s

# Start the Socket.IO listener (default: true).
# SOCKETIO_ENABLED=true
